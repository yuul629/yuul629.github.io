---
import ProfilePhoto from '@components/about/ProfilePhoto.astro';
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { getAuthors, getBoolField, getTitle, getVenue, getYear, parseBibtex } from '@utils/bibtex';
import { getCollection, render } from 'astro:content';

import AboutContent from '../data/about.mdx';
import bibRaw from '../data/papers.bib?raw';

// Announcements
const allAnnouncements = site.announcements.enabled
  ? (await getCollection('announcements'))
      .filter((e) => !e.data.hidden)
      .sort((a, b) => {
        if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
        return b.data.date.getTime() - a.data.date.getTime();
      })
      .slice(0, site.announcements.limit)
  : [];

// Latest posts
const allPosts = site.latestPosts.enabled
  ? (await getCollection('posts'))
      .filter((p) => !p.data.hidden)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
      .slice(0, site.latestPosts.limit)
  : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Selected publications
const selectedPapers = site.selectedPapers.enabled
  ? parseBibtex(bibRaw).filter((e) => getBoolField(e, 'selected'))
  : [];

// Pre-render announcement content
const renderedAnnouncements = await Promise.all(
  allAnnouncements.map(async (item) => ({ item, rendered: await render(item) })),
);
---

<Base isHome={true}>
  <div class="post page-container py-8">
    <header class="post-header">
      <h1
        class="post-title"
        style="font-family: var(--font-sans); color: var(--global-text-color);"
      >
        {(site.title as string) === 'blank' ? site.author.name : site.title}
      </h1>
      {
        site.author.subtitle && (
          <p
            class="desc"
            style="color: var(--global-text-color-light);"
            set:html={site.author.subtitle}
          />
        )
      }
    </header>

    <article class="about-section">
      <!-- Profile photo (floats right by default) -->
      <ProfilePhoto align="right" />

      <div class="clearfix">
        <!-- Bio content from about.mdx -->
        <div class="prose max-w-none">
          <h2>About</h2>
          <AboutContent />
        </div>
      </div>

      <div class="about-columns">
        <section>
          <h2>Things I love</h2>
          <ul class="star-list">
            <li>Learning and developing my skills in design and technology</li>
            <li>Realizing my ideas using AI</li>
            <li>Challenging myself to learn a new skill every year</li>
            <li>Reading and exploring different perspectives on life</li>
            <li>Exploring the outdoors</li>
          </ul>
        </section>

        <section>
          <h2>Things I have accomplished</h2>
          <ul class="star-list">
            <li>Team project won the “Most Viable Startup” award</li>
            <li>Team project won the “Most Aesthetic” award</li>
            <li>Nominee for the Creative Technology graduation award</li>
            <li>Taught myself to sew</li>
          </ul>
        </section>
      </div>

<style>
  .clearfix::after {
    content: '';
    display: table;
    clear: both;
  }
  .post-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .desc {
    font-size: 1rem;
    margin-bottom: 1rem;
  }

  .about-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 0.75rem;
    margin-bottem: 5rem;
  }

  .about-columns h2 {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .star-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .star-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .star-list li::before {
    content: '★';
    position: absolute;
    left: 0;
    color: var(--global-theme-color) !important;
  }

  @media (max-width: 700px) {
    .about-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

.post-header {
  margin-top: 15rem;
  margin-bottom: 10rem;
}
</style>
