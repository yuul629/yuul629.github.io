---
import { site } from '@config/site';

import IconGithub from '~icons/fa-brands/github';
import IconLinkedin from '~icons/fa-brands/linkedin';
import IconEnvelope from '~icons/fa-solid/envelope';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-container footer-inner">
    {
      site.footer.showContact && (
        <div class="footer-contact">
          <strong class="footer-contact-title">Contact</strong>

          <a class="contact-row" href={`mailto:${site.author.email}`}>
            <IconEnvelope />
            <span>{site.author.email}</span>
          </a>

          {site.socials.linkedin_username && (
            <a
              class="contact-row"
              href={`https://www.linkedin.com/in/${site.socials.linkedin_username}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconLinkedin />
              <span>LinkedIn</span>
            </a>
          )}

          {site.socials.github_username && (
            <a
              class="contact-row"
              href={`https://github.com/${site.socials.github_username}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <IconGithub />
              <span>GitHub</span>
            </a>
          )}
        </div>
      )
    }

    <div class="footer-meta">
      <span>&copy; {year} {site.author.name}.</span>

      {site.footer.text && <span set:html={site.footer.text} />}
    </div>
  </div>
</footer>
